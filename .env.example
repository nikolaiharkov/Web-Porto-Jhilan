# Salin menjadi .env lalu isi nilainya.

# Wajib di produksi: minimal 32 karakter acak.
# Contoh pembuatan: openssl rand -hex 32
SESSION_SECRET=

# Akun bootstrap. Hanya dipakai saat tabel users masih kosong.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Origin publik absolut, tanpa trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lokasi penyimpanan persisten (database + media).
# Di container arahkan ke volume, misal /data
DATA_DIR=./storage
